rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 200;
    }

    function isValidNotebook(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title'])
        && data.id is string
        && data.id.size() <= 128
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() <= 500;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      match /notebooks/{notebookId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(notebookId) && isValidNotebook(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(notebookId) && isValidNotebook(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(notebookId);
      }
    }
  }
}
